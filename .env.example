# Stripe one-time product for the Executive PDF Report.
# Configure these in Vercel (and locally) before enabling checkout.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_EXECUTIVE_REPORT_PRICE_ID=price_replace_me
STRIPE_TEAM_ANALYSIS_PRICE_ID=price_replace_me
# Recurring Stripe Price for the Enterprise / Coach white-label tier.
STRIPE_ENTERPRISE_WHITE_LABEL_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# One-time Stripe price and the number of invitation credits included in a pack.
STRIPE_COACH_CREDIT_PACK_PRICE_ID=price_replace_me
STRIPE_COACH_CREDIT_PACK_SIZE=5

# Supabase browser credentials (safe to expose through Vite) and server-only service role key.
# Use the anon key from Supabase. Newer projects may instead use
# VITE_SUPABASE_PUBLISHABLE_KEY; the client supports either name.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ_replace_me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Resend email delivery for coach assessment invitations.
RESEND_API_KEY=re_replace_me
INVITE_EMAIL_FROM="Northstar DISC <invites@example.com>"
